---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { defaultLocale, hq } from "../../i18n/ui";
import { localePath } from "../../i18n/utils";

export async function getStaticPaths() {
  const agencies = await getCollection("agencies");
  return agencies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

/** A branch's `phone` can be a single number or several joined by " · " (e.g. landline +
 *  WhatsApp) for display — both `tel:` and schema.org `telephone` want just the primary one. */
function primaryPhone(phone: string): string {
  return phone.split("·")[0].trim();
}
function telHref(phone: string): string {
  return `tel:${primaryPhone(phone).replaceAll(" ", "")}`;
}

/** Plain-text OpenStreetMap link, no embedded map (REMEDIATION-PLAN.md PR 6: an iframe would
 *  blow the request/weight budgets and is explicitly out of scope). */
function mapsHref(geo: { lat: number; lng: number }): string {
  return `https://www.openstreetmap.org/?mlat=${geo.lat}&mlon=${geo.lng}#map=17/${geo.lat}/${geo.lng}`;
}

const pageUrl = new URL(localePath(defaultLocale, `/agences/${entry.id}/`), Astro.site).toString();

// One LocalBusiness per physical branch (BUILD-PLAN.md §8, WP5). `geo` is included only for
// branches geocoded with confidence (src/content.config.ts's `geo`/`geoSource` comments); a
// wrong pin is worse than none. `openingHours` is included only for the one branch that IS the
// head office (`isHeadOffice`) — no other branch has verified hours (TODO(content) D6).
const jsonLd = entry.data.branches.map((branch) => ({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: `Oris Finance — ${branch.name}`,
  url: pageUrl,
  address: {
    "@type": "PostalAddress",
    streetAddress: branch.location,
    addressLocality: entry.data.city,
    addressCountry: "CM",
  },
  telephone: primaryPhone(branch.phone),
  email: branch.email,
  ...(branch.image && { image: new URL(branch.image.src, Astro.site).toString() }),
  ...(branch.geo && {
    geo: { "@type": "GeoCoordinates", latitude: branch.geo.lat, longitude: branch.geo.lng },
  }),
  ...(branch.isHeadOffice && { openingHours: hq.hours.schemaOrg }),
}));

// First branch with a photo stands in for the page — a page can cover several physical
// branches (e.g. Douala), so there's no single "the" agency image to point at.
const coverBranch = entry.data.branches.find((branch) => branch.image);
---

<Base
  title={`${entry.data.title} — Oris Finance`}
  description={`Coordonnées et adresses des agences Oris Finance à ${entry.data.city}.`}
  path={`/agences/${Astro.params.slug}/`}
  jsonLd={jsonLd}
  image={coverBranch?.image}
  imageAlt={coverBranch ? `Agence Oris Finance — ${coverBranch.name}` : undefined}
>
  <div class="mx-auto flex max-w-3xl flex-col gap-8 px-4 py-12 md:px-8">
    <a
      href="/agences/"
      class="flex w-fit items-center gap-1 text-small text-indigo-400 underline underline-offset-2"
    >
      <Icon name="lucide:arrow-left" width={20} height={20} class="shrink-0" aria-hidden="true" />
      Nos agences
    </a>

    <h1 class="text-h1 font-heading">{entry.data.title}</h1>

    <div class="flex flex-col gap-6">
      {entry.data.branches.map((branch) => (
        <div class="flex flex-col gap-3 rounded-card border border-neutral-200 p-4 sm:flex-row">
          {branch.image && (
            // Content, not decorative (REMEDIATION-PLAN.md PR8, BUILD-PLAN.md §6): a real
            // branch exterior — described from the branch's own name/city, nothing invented.
            <Image
              src={branch.image}
              alt={`Façade de l’agence Oris Finance de ${branch.name}, ${entry.data.city}`}
              width={280}
              height={180}
              class="h-40 w-full rounded-input object-cover sm:w-56 sm:shrink-0"
            />
          )}
          <div class="flex flex-col gap-2">
            <h2 class="text-h3 font-heading">{branch.name}</h2>
            <p class="flex items-center gap-2 text-body text-neutral-500">
              <Icon name="lucide:map-pin" width={20} height={20} class="shrink-0" aria-hidden="true" />
              {branch.location}
            </p>
            <a
              href={telHref(branch.phone)}
              class="flex items-center gap-2 text-body text-indigo-400 underline underline-offset-2"
            >
              <Icon name="lucide:phone" width={20} height={20} class="shrink-0 text-teal-700" aria-hidden="true" />
              {branch.phone}
            </a>
            <a
              href={`mailto:${branch.email}`}
              class="flex items-center gap-2 text-body text-indigo-400 underline underline-offset-2"
            >
              <Icon name="lucide:mail" width={20} height={20} class="shrink-0 text-teal-700" aria-hidden="true" />
              {branch.email}
            </a>
            {branch.isHeadOffice && (
              <div class="text-small text-neutral-500">
                {hq.hours.display.map((row) => (
                  <p>{row.days} : {row.range}</p>
                ))}
              </div>
            )}
            {branch.geo && (
              <a
                href={mapsHref(branch.geo)}
                class="text-small text-indigo-400 underline underline-offset-2"
              >
                Itinéraire →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</Base>
