---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { productFamilyIcons } from "../../lib/icons";

export async function getStaticPaths() {
  const families = await getCollection("products", (entry) => entry.data.locale === "fr");
  return families.map((entry) => ({
    params: { slug: entry.id.replace(/^fr\//, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/^fr\//, "");
const coverItem = entry.data.items.find((item) => item.image);
---

<Base
  title={`${entry.data.title} — Oris Finance`}
  description={entry.data.title}
  path={`/nos-produits/${Astro.params.slug}/`}
  image={coverItem?.image}
  imageAlt={coverItem?.name}
>
  <div class="mx-auto flex max-w-4xl flex-col gap-8 px-4 py-12 md:px-8">
    <a
      href="/nos-produits/"
      class="flex w-fit items-center gap-1 text-small text-indigo-400 underline underline-offset-2"
    >
      <Icon name="lucide:arrow-left" width={20} height={20} class="shrink-0" aria-hidden="true" />
      Nos produits
    </a>

    <div class="flex items-center gap-3">
      {productFamilyIcons[slug] && (
        <Icon name={productFamilyIcons[slug]} width={24} height={24} class="shrink-0 text-teal-500" aria-hidden="true" />
      )}
      <h1 class="text-h1 font-heading">{entry.data.title}</h1>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {entry.data.items.map((item) => (
        <div class="flex flex-col gap-3 rounded-card border border-neutral-200 p-4">
          {item.image && (
            // Decorative (REMEDIATION-PLAN.md PR8): every item.image in this collection is the
            // product's own logo/wordmark (e.g. Oris Care, Oris Money), not a photograph — the
            // h2 right below repeats the same name, so it carries no information alt text would add.
            <Image src={item.image} alt="" width={320} height={200} class="h-40 w-full rounded-input object-cover" />
          )}
          <h2 class="text-h3 font-heading">{item.name}</h2>
          <p class="text-body">{item.description}</p>
          {item.link && (
            <a href={item.link} class="text-small text-indigo-400 underline underline-offset-2">
              {item.link.startsWith("http") ? "En savoir plus" : "Souscrire"}
            </a>
          )}
        </div>
      ))}
    </div>

    <div class="text-body rich-text">
      <Content />
    </div>
  </div>
</Base>
