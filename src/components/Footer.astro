---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { defaultLocale, hq, navItems, type Locale } from "../i18n/ui";
import { localePath, useTranslations } from "../i18n/utils";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
const year = new Date().getFullYear();

// Mirrors Header.astro's filter — navItems used to be pushed straight through localePath()
// regardless, which on /en/ emitted dead links (REMEDIATION-PLAN.md PR2).
const footerNavItems = navItems.filter((item) => item.locales.includes(locale));

// Locale-agnostic collection (src/content.config.ts: "an address and phone number aren't
// translated") — same four branches regardless of locale, alphabetised by display title.
const agencies = (await getCollection("agencies")).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<footer class="bg-indigo-500 text-neutral-50">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-8 px-4 py-12 md:grid-cols-3 md:px-8">
    <div class="flex flex-col gap-4">
      <p class="text-body font-heading">Oris Finance</p>
      <div class="text-small flex flex-col gap-1 text-neutral-100">
        <p class="flex items-center gap-2">
          <Icon name="lucide:map-pin" width={20} height={20} class="shrink-0" aria-hidden="true" />
          {t("footer.hqLabel")}: {hq.streetAddress}
        </p>
        <p class="flex flex-wrap items-center gap-2">
          <span class="flex items-center gap-2">
            <Icon name="lucide:phone" width={20} height={20} class="shrink-0" aria-hidden="true" />
            <a href={`tel:${hq.phoneE164}`} class="hover:underline">{hq.phoneDisplay}</a>
          </span>
          <span aria-hidden="true">·</span>
          <span class="flex items-center gap-2">
            <Icon name="lucide:mail" width={20} height={20} class="shrink-0" aria-hidden="true" />
            <a href={`mailto:${hq.email}`} class="hover:underline">{hq.email}</a>
          </span>
        </p>
        <p>
          {hq.hours.display.map((row, i) => (
            <>
              {i > 0 && " · "}
              {row.days} : {row.range}
            </>
          ))}
        </p>
      </div>
    </div>

    <nav class="flex flex-col gap-3" aria-label={t("footer.navLabel")}>
      <p class="text-label text-neutral-100">{t("footer.navHeading")}</p>
      <ul class="text-small flex flex-col gap-2">
        {footerNavItems.map((item) => (
          <li>
            <a href={localePath(locale, item.path)} class="hover:underline">{t(item.labelKey)}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="flex flex-col gap-3" aria-label={t("footer.agenciesLabel")}>
      <p class="text-label text-neutral-100">{t("footer.agenciesLabel")}</p>
      <ul class="text-small flex flex-col gap-2">
        {agencies.map((entry) => (
          <li>
            <a href={`/agences/${entry.id}/`} class="hover:underline">{entry.data.title}</a>
          </li>
        ))}
        <li>
          <a href="/agences/" class="hover:underline">{t("footer.allAgencies")}</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-indigo-400">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 md:px-8">
      <p class="text-small tabular-nums text-neutral-100">© {year} Oris Finance — {t("footer.rights")}</p>
      <!-- TODO(WP6): link /mentions-legales/ once the route exists — content is TODO(content)
           per WP1 (RCCM/NIU/regulator all missing, cannot be drafted from imagination). -->
    </div>
  </div>
</footer>
