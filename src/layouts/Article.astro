---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";

interface Props {
  entry: CollectionEntry<"news">;
  path: string;
}

const { entry, path } = Astro.props;
const formattedDate = entry.data.date.toLocaleDateString("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
};
---

<Base
  title={`${entry.data.title} — Oris Finance`}
  description={entry.data.description}
  path={path}
  jsonLd={[articleJsonLd]}
  ogType="article"
>
  <article class="mx-auto flex max-w-3xl flex-col gap-8 px-4 py-12 md:px-8">
    <a
      href="/actualites/"
      class="flex w-fit items-center gap-1 text-small text-indigo-400 underline underline-offset-2"
    >
      <Icon name="lucide:arrow-left" width={20} height={20} class="shrink-0" aria-hidden="true" />
      Actualités
    </a>

    {entry.data.featured && (
      <p class="rounded-card border border-magenta-600 bg-neutral-50 px-4 py-3 text-small font-heading text-magenta-600">
        Information de sécurité client
      </p>
    )}

    <header class="flex flex-col gap-3">
      <p class="text-label text-indigo-500">
        <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
      </p>
      <h1 class="text-h1 font-heading">{entry.data.title}</h1>
    </header>

    <div class="text-body rich-text">
      <slot />
    </div>
  </article>
</Base>
